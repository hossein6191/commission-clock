# The deployed Commission Clock contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts) with scripted verdicts for the demo
# maker's moves, the suggested replies and the five drafts; no wallet and no network. For local work and for
# showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>): the footer's Source link, and the repository the
# demo maker's pinned draft addresses are built from. On Vercel the repository the site was built from is used when
# this is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables).
NEXT_PUBLIC_REPO_URL=

# The commit (40 hex characters) whose drafts/ the demo maker delivers, as raw.githubusercontent.com serves them.
# Empty: lib/config.ts DRAFTS_COMMIT is used; with both empty the demo maker can talk but not deliver.
NEXT_PUBLIC_DRAFTS_COMMIT=

# The demo studio's id, only when the server has no DEMO_MAKER_KEY: the server otherwise finds the studio the key opened.
NEXT_PUBLIC_DEMO_STUDIO=

# Server only. A throwaway Studio test key that opened the demo studio (tools/open-demo-studio.mjs). POST
# /api/demo/accept and /api/demo/act sign with it: accept() on a request of the demo studio, and say() or deliver()
# from the fixed script in lib/demo-studio.ts. Never a key that holds anything real. Pasted with or without 0x, with
# or without quotes. Unset: the site works, and GET /api/demo/status says exactly why the demo maker is away.
DEMO_MAKER_KEY=
